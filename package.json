{
  "name": "turbopanel",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "cert:generate": "node scripts/generate-self-signed-cert.mjs",
    "caddy:install": "node scripts/download-caddy.mjs",
    "deploy": "pnpm migrate && wrangler deploy --env $CLOUDFLARE_ENV --minify --var TURBOPANEL_REVISION:$(git rev-parse HEAD)",
    "deploy:workers": "pnpm run deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "generate:secret": "node scripts/generate-secret.mjs",
    "generate": "drizzle-kit generate --config drizzle.config.mjs",
    "migrate": "node scripts/check-postgres-compat.mjs && drizzle-kit migrate --config drizzle.config.mjs",
    "test:do": "vitest run --config vitest.config.ts",
    "test:coverage": "sh scripts/test-coverage.sh",
    "check:do-hibernation": "node scripts/check-durable-object-hibernation.mjs",
    "check:do-hibernation:fixtures": "node scripts/check-durable-object-hibernation.mjs --fixtures",
    "check:workers-bundle": "node scripts/check-workers-bundle.mjs",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "check:test-inventory": "node scripts/check-test-inventory.mjs",
    "notices:generate": "deno task notices:generate",
    "notices:check": "deno task notices:check",
    "check:ca-boundary": "node scripts/check-ca-boundary.mjs",
    "check:v5-boundaries": "node scripts/check-v5-boundaries.mjs",
    "test:hook": "deno task check:types && pnpm run check:do-hibernation && pnpm run check:workers-bundle && pnpm run check:vocabulary && pnpm run check:test-inventory && pnpm run notices:check && pnpm run check:ca-boundary && pnpm run check:v5-boundaries && pnpm test:do && deno task test:authn && deno task test:permissions && deno task test:authz && deno task test:paths && deno task test:compose && deno task test:managed && deno task test:admin"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@noble/hashes": "1.8.0",
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.43.1",
    "hono": "4.12.23",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.10.1",
    "postgres": "^3.4.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-istanbul": "^4.1.0",
    "drizzle-kit": "^0.31.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
